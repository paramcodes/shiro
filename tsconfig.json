{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["packages/contracts/src/**/*", "apps/server/src/**/*.ts", "apps/web/src/**/*.tsx", "apps/web/src/**/*.ts", "types/**/*.d.ts", "apps/web/vite.config.ts"],
  "exclude": ["apps/web/src/__tests__"]
}
